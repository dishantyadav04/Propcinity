# ─── Supabase ───────────────────────────────────────────────────────────────
# Your project URL and anon key from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ─── App URL ────────────────────────────────────────────────────────────────
# Used for OAuth callback URLs and OG metadata. Use your production domain.
NEXT_PUBLIC_APP_URL=https://propcinity.in

# ─── AI ─────────────────────────────────────────────────────────────────────
# OpenAI key — used for AI advisor and recommendation engine
OPENAI_API_KEY=
# NOTE: ANTHROPIC_API_KEY was removed. AI now runs exclusively on OpenAI.

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
# R2 credentials from Cloudflare dashboard → R2 → Manage API tokens
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL of your R2 bucket (e.g. https://images.propcinity.in)
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Email ──────────────────────────────────────────────────────────────────
# Resend API key for transactional emails (resend.com)
RESEND_API_KEY=
# Ops/admin email that receives lead notifications
OPS_EMAIL=

# ─── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog — ingestion endpoint (events, flags, session recording API)
NEXT_PUBLIC_POSTHOG_HOST=https://ingest.propcinity.in

# PostHog — UI host (toolbar, debug, project dashboard links)
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# ─── Admin Panel ────────────────────────────────────────────────────────────
# Set a strong password for /admin access
ADMIN_PASSWORD=

# ─── Admin IP Allowlist ─────────────────────────────────────────────────────
# Comma-separated list of IPv4/IPv6 addresses allowed to access /admin routes.
#
# FAIL-OPEN: If this var is empty or unset, ALL IPs can reach /admin (no
#   IP restriction). This is intentional for local dev but means you MUST
#   set a non-empty value in Production if you want the gate enforced.
#
# REDEPLOY REQUIRED: Editing this value in the Vercel dashboard does NOT take
#   effect until you trigger a full redeploy (even if Vercel shows the new
#   value immediately). Always redeploy after changing this var.
#
# DIAGNOSING A 403 LOCKOUT:
#   1. Hit GET https://<your-domain>/api/debug-ip to see the IP the edge
#      resolves for your request (mirrors exactly what isIpAllowed() uses).
#   2. Compare that IP to the list below.
#   3. Add the IP here, save, and trigger a full redeploy.
#   OR clear this var entirely — password + TOTP are still required to log in.
#
# Find your current IP: https://whatismyipaddress.com
ADMIN_ALLOWED_IPS=

# ─── Admin TOTP (2FA) ───────────────────────────────────────────────────────
# Generate a secret with: node -e "const o=require('otpauth'); console.log(new o.Secret({size:20}).base32)"
# Then scan the URI from generateTotpQrUrl() in your authenticator app.
# Leave empty to disable TOTP (not recommended for production).
ADMIN_TOTP_SECRET=

# ─── Upstash Redis ──────────────────────────────────────────────────────────
# Required for persistent rate limiting and AI chat daily limits.
# Get from upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Dev Origins ─────────────────────────────────────────────────
# Comma-separated origins for Next.js dev server (e.g. localhost,192.168.1.33)
ALLOWED_DEV_ORIGINS=localhost

# ─── Sentry ──────────────────────────────────────────────────────────────────
# Client-side DSN for error monitoring and traces
NEXT_PUBLIC_SENTRY_DSN=
# Server-side only — used at build time for source map uploads, never prefix with NEXT_PUBLIC_
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
# Secret header value Vercel sends with scheduled cron requests. Generate with:
# node -e "console.log(require('crypto').randomUUID())"
CRON_SECRET=
