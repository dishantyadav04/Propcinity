# ─── Supabase ───────────────────────────────────────────────────────────────
# Your project URL and anon key from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# ─── App URL ────────────────────────────────────────────────────────────────
# Used for OAuth callback URLs and OG metadata. Use your production domain.
NEXT_PUBLIC_APP_URL=https://propcinity.in

# ─── AI ─────────────────────────────────────────────────────────────────────
# OpenAI key — used for AI advisor and recommendation engine
OPENAI_API_KEY=
# NOTE: ANTHROPIC_API_KEY was removed. AI now runs exclusively on OpenAI.

# ─── Cloudflare R2 ──────────────────────────────────────────────────────────
# R2 credentials from Cloudflare dashboard → R2 → Manage API tokens
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL of your R2 bucket (e.g. https://images.propcinity.in)
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Email ──────────────────────────────────────────────────────────────────
# Resend API key for transactional emails (resend.com)
RESEND_API_KEY=
# Ops/admin email that receives lead notifications
OPS_EMAIL=

# ─── WhatsApp ───────────────────────────────────────────────────────────────
# Phone number in international format without + (e.g. 919999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Analytics ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Admin Panel ────────────────────────────────────────────────────────────
# Set a strong password for /admin access
ADMIN_PASSWORD=

# ─── Upstash Redis ──────────────────────────────────────────────────────────
# Required for persistent rate limiting and AI chat daily limits.
# Get from upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Dev Origins ─────────────────────────────────────────────────
# Comma-separated origins for Next.js dev server (e.g. localhost,192.168.1.33)
ALLOWED_DEV_ORIGINS=localhost
